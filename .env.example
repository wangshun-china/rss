# 复制为 .env 并填入真实值；.env 已被 gitignore，不会提交

# ---- 飞书（必填）----
FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx
# 机器人开启"签名校验"时填，没开留空（选填）
FEISHU_SECRET=

# ---- X (Twitter) ----
# 服务器 poller.py 增量轮询用；本地 main.py 的 syndication 备用通道不需要
TWITTER_API_KEY=
# 本地/国内环境直连 x.com 困难时配代理
TWITTER_PROXY=http://127.0.0.1:7890

# ---- Reddit（选填）----
# RSS 被 403/429 时自动切换 OAuth 拉取的兜底凭据；Actions 直连 RSS 可用时不配
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_PROXY=http://127.0.0.1:7890

# ---- AI 翻译与总结（选填，OpenAI 兼容接口；不配则只推原文）----
AI_API_BASE=
AI_API_KEY=
AI_MODEL=

# ---- 范围与运行参数（一般不用改）----
# 源范围：all 或逗号组合 twitter/reddit/hn/rss
# RSS_SOURCES=all
# 状态目录（容器内挂载卷）与状态文件路径（Actions 单源场景）
# RSS_DATA_DIR=
# RSS_STATE_FILE=
# poller 轮询间隔秒数
# POLL_INTERVAL_SECONDS=3600
