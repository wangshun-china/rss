# 复制为 .env 并填入真实值；.env 已被 gitignore，不会提交
# twitterapi.io 的 API Key
TWITTER_API_KEY=new1_xxxxxxxxxxxxxxxxxxxxxxxx

# 飞书群自定义机器人 webhook（必填）
FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx
# 若机器人开启了"签名校验"，填签名密钥；没开就留空（选填）
FEISHU_SECRET=

# Reddit OAuth 凭据（选填）：RSS 被 403/限流时自动切换到 OAuth 拉取
# 在 https://www.reddit.com/prefs/apps 创建 script 应用后获取
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
