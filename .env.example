# 复制为 .env 并填入真实值；.env 已被 gitignore，不会提交

# ---- 飞书（必填）----
FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx
# 机器人开启"签名校验"时填，没开留空（选填）
FEISHU_SECRET=

# ---- Reddit（选填）----
# RSS 被 403/429 时自动切换 OAuth 拉取的兜底凭据；Actions 直连 RSS 可用时不配。
# REDDIT_PROXY 供本地/国内环境直连困难时走代理
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_PROXY=http://127.0.0.1:7890

# ---- AI 翻译与总结（选填，OpenAI 兼容接口；不配则只推原文）----
AI_API_BASE=
AI_API_KEY=
AI_MODEL=

# ---- 范围与运行参数（一般不用改）----
# 源范围：all 或逗号组合 reddit/hn/rss
# RSS_SOURCES=all
# 状态文件路径（Actions 单源场景用 RSS_STATE_FILE=state-reddit.json）
# RSS_STATE_FILE=
